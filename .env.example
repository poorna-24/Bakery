# Copy to .env.local and fill in. Never commit the filled-in copy.
# DATABASE_URL must also go in .env — the Prisma CLI does not read .env.local.

# Both apps must point at the same database and the same data folder.
DATABASE_URL="file:../../data/bakery.db"
BAKERY_DATA_DIR="../data"

# Where the Preview tab points.
CUSTOMER_APP_URL="http://localhost:3000"

# The only account that can sign in.
ADMIN_EMAIL="owner@yourbakery.com"

# Development only. Before going live, delete this and set ADMIN_PASSWORD_HASH:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" "your-password"
ADMIN_PASSWORD="change-me"
# ADMIN_PASSWORD_HASH=""

# Signs the login cookie. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

NEXT_PUBLIC_SHOP_NAME="Your Bakery"
