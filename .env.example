# Copy to .env.local and fill in.
# DATABASE_URL must also go in .env — the Prisma CLI does not read .env.local.

# Both apps must point at the same database and the same data folder.
DATABASE_URL="file:../../data/bakery.db"
BAKERY_DATA_DIR="../data"

NEXT_PUBLIC_SHOP_NAME="Your Bakery"
NEXT_PUBLIC_SHOP_TAGLINE="Handcrafted delights, made fresh every morning."

# Shown in the footer, with a "Get directions" button that opens the map link.
NEXT_PUBLIC_SHOP_ADDRESS=""
NEXT_PUBLIC_SHOP_MAP_URL=""

# Optional. Set it and a "Call the shop" button appears.
NEXT_PUBLIC_SHOP_PHONE=""
