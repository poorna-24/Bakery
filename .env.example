# The one environment file for the whole project. Copy and fill in:
#
#   cp .env.example .env
#
# Both apps read it — each app's next.config.mjs loads it, and the Prisma
# scripts go through scripts/load-root-env.mjs. There are no per-app env files.
#
# Docker reads it too, but overrides DATABASE_URL and DIRECT_URL with its own
# throwaway Postgres, so containers never touch production data.
#
# Vercel ignores this file entirely. Set the same names in each project's
# dashboard — the database URLs in both, the rest in the admin only.

# ---------------------------------------------------------------- database
# Supabase. The pooler on 6543 for queries; the direct line on 5432 for schema
# changes, which cannot run through a pooler.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Password for the local Postgres container only. Nothing outside Docker uses it.
POSTGRES_PASSWORD="anything-local"

# ------------------------------------------------------------- admin login
ADMIN_EMAIL="owner@yourbakery.com"

# Development only. Before going live, clear this and set ADMIN_PASSWORD_HASH:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" "your-password"
ADMIN_PASSWORD="change-me"
ADMIN_PASSWORD_HASH=""

# Signs the login cookie. At least 16 characters or the app refuses to start.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# The deployed address, used when generating the QR code (npm run qr).
# The dashboard's Preview tab no longer needs it — the menu is the same app.
SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------ images
# Leave empty to store photos on local disk instead of Cloudinary. Required
# once the two apps run on separate servers, which cannot share a disk.
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""
# Cloudinary folder for uploads. Empty means "bakery" (production); QA sets
# "bakery-qa" so test photos stay out of the live menu's folder.
CLOUDINARY_FOLDER=""

# ------------------------------------------------------------- environment
# Empty in production. On QA set it to "QA": a banner across the top says so,
# and search engines are told not to index the test copy.
ENVIRONMENT_LABEL=""

# ------------------------------------------------------------ shop details
# Read on the server and passed down as props, so these are plain runtime
# values: change one and a restart is enough — no rebuild.
SHOP_NAME="Your Bakery"
SHOP_TAGLINE="Handcrafted delights, made fresh every morning."
SHOP_ADDRESS=""
SHOP_MAP_URL=""
SHOP_PHONE=""
SHOP_WHATSAPP=""

# Credit line at the foot of the menu. Empty name hides it.
CREDIT_NAME=""
CREDIT_WHATSAPP=""

# ------------------------------------------------------------------- build
# Only needed on a network that re-signs TLS with its own root certificate,
# where prisma generate cannot verify binaries.prisma.sh during a Docker build.
# EXTRA_CA_CERTS_FILE="C:/path/to/root-ca.pem"
