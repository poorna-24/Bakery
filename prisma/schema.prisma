// Shared schema. An identical copy lives in bakery-customer/prisma/schema.prisma
// so both apps generate the same client against the same database.
//
// Hosted on Supabase Postgres. Both repos must point at the same database:
// the admin writes, the customer app reads, and that shared connection is the
// only thing linking the two.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Normal queries go through the connection pooler: serverless functions open
  // and close connections constantly and would exhaust Postgres otherwise.
  url       = env("DATABASE_URL")
  // Schema changes cannot run through a pooler, so they use a direct line.
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items Item[]

  @@index([sortOrder])
}

model Item {
  id           String   @id @default(cuid())
  categoryId   String
  name         String
  description  String   @default("")
  price        Float    @default(0)
  unit         String   @default("per piece")
  imageUrl     String?
  isVeg        Boolean  @default(true)
  isEggless    Boolean  @default(false)
  isBestseller Boolean  @default(false)
  isAvailable  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants ItemVariant[]

  @@index([categoryId, sortOrder])
}

model ItemVariant {
  id        String @id @default(cuid())
  itemId    String
  label     String
  price     Float
  sortOrder Int    @default(0)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
}

/// Shop-wide settings as key/value pairs — the admin writes them, the customer
/// app reads them. Key/value rather than columns so adding the next setting
/// does not need a migration in two repos.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// An order a customer sent from the menu. Saved before WhatsApp opens, so the
/// dashboard has a record even though the conversation happens in WhatsApp.
model Order {
  id        String   @id @default(cuid())
  /// The short reference both sides see: "#B7K2" in WhatsApp and the dashboard.
  code      String   @unique
  /// table | counter | pickup | delivery
  mode      String
  tableNo   Int?
  name      String   @default("")
  phone     String   @default("")
  address   String   @default("")
  /// Shared from the customer's phone for deliveries; null when they typed only.
  latitude  Float?
  longitude Float?
  whenText  String   @default("")
  note      String   @default("")
  /// cash | upi | card, or "" when the shop does not ask.
  payment   String   @default("")
  paid      Boolean  @default(false)
  /// new | preparing | ready | completed | cancelled
  status    String   @default("new")
  total     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines OrderLine[]

  @@index([createdAt])
}

/// One line of an order. Name and price are copied, not linked: an item renamed,
/// repriced or deleted later must not rewrite what the customer ordered.
model OrderLine {
  id      String  @id @default(cuid())
  orderId String
  itemId  String
  name    String
  size    String?
  price   Float
  qty     Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
