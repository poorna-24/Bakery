# The server's .env — copy to ~/Bakery/.env on the Oracle server and fill in.
# Never commit the filled-in copy.
#
# Values containing $ (the password hash does) MUST be in 'single quotes',
# or Docker reads the $ parts as variables and silently mangles them.

# The address customers use. Your own domain, or a free one made from the
# server's public IP: 140.238.10.20 -> 140-238-10-20.sslip.io
DOMAIN=140-238-10-20.sslip.io

# The server's own database. Long and random:
#   openssl rand -hex 24
POSTGRES_PASSWORD='change-me-to-a-long-random-value'

ADMIN_EMAIL=owner@bakery.com
# Hash only — never a plain password on a public server. Make one on your PC,
# in the Bakery folder:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" "your-password"
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH='$2a$10$replace-with-your-hash'

# A NEW secret, not the one from Vercel (that one is in old git history):
#   openssl rand -hex 48
SESSION_SECRET='replace-with-openssl-rand-hex-48'

# Photos stay on Cloudinary, exactly as now.
CLOUDINARY_URL='cloudinary://<api_key>:<api_secret>@<cloud_name>'

SHOP_NAME=BAKERY NAME
SHOP_TAGLINE=Handcrafted delights, made fresh every morning.
SHOP_ADDRESS=Cherial, Telangana
SHOP_MAP_URL=
SHOP_PHONE=
SHOP_WHATSAPP=
CREDIT_NAME=
CREDIT_WHATSAPP=
