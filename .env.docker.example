# Copy to .env next to docker-compose.yml, then fill in.
# The filled-in copy holds a password and a signing key — keep it off GitHub.
#
#   cp .env.docker.example .env

# --------------------------------------------------------------- database
# Local only: this database lives in a Docker volume, not on Supabase.
POSTGRES_PASSWORD="choose-anything-local"

# ------------------------------------------------------------ admin login
ADMIN_EMAIL="owner@yourbakery.com"

# Local use. Before exposing the admin anywhere, clear this and set
# ADMIN_PASSWORD_HASH instead:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" "your-password"
ADMIN_PASSWORD="change-me"
ADMIN_PASSWORD_HASH=""

# Signs the login cookie. Must be at least 16 characters or the app refuses to
# start. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# ----------------------------------------------------------------- photos
# Leave empty and photos are written to the shared `uploads` volume, which both
# containers mount. Set it to push them to Cloudinary instead.
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""

# ------------------------------------------------------------- shop details
# These are baked into the customer bundle when its image is built, so after
# changing any of them: docker compose up -d --build customer
NEXT_PUBLIC_SHOP_NAME="SHIVAM BAKERY"
NEXT_PUBLIC_SHOP_TAGLINE="Handcrafted delights, made fresh every morning."
NEXT_PUBLIC_SHOP_ADDRESS="Cherial, Telangana"
NEXT_PUBLIC_SHOP_MAP_URL="https://maps.app.goo.gl/ZvQ7RebnL8WHDhFg6"
NEXT_PUBLIC_SHOP_PHONE="+91 76660 93143"
NEXT_PUBLIC_SHOP_WHATSAPP="+91 76660 93143"

# Credit line at the foot of the menu. Empty name hides it.
NEXT_PUBLIC_CREDIT_NAME="Poorna Chander Terala"
NEXT_PUBLIC_CREDIT_WHATSAPP="+918099057599"

# Only if your network re-signs TLS (corporate proxy). Otherwise leave unset.
# EXTRA_CA_CERTS_FILE="C:/Users/poterala/.node-ca/windows-root-ca.pem"
