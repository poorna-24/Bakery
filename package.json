{
  "name": "bakery-customer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "postinstall": "prisma generate",
    "qr": "node scripts/qr.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "openapi:validate": "node -e \"require('@apidevtools/swagger-parser').validate('openapi/openapi.yaml').then(a=>console.log('valid:',a.info.title,a.info.version)).catch(e=>{console.error(e.message);process.exit(1)})\""
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "next": "^15.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "20.17.16",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "jsdom": "^25.0.1",
    "openapi-types": "^12.1.3",
    "postcss": "8.5.1",
    "prisma": "6.2.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "^2.1.8"
  }
}
