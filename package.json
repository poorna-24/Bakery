{
  "name": "bakery",
  "version": "1.0.0",
  "private": true,
  "description": "The bakery menu and the owner's dashboard in one Next.js app: the menu is public at /, the dashboard is behind a login at /admin.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/load-root-env.mjs prisma generate && next build",
    "start": "next start -p 3000",
    "postinstall": "node scripts/load-root-env.mjs prisma generate",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:push": "node scripts/load-root-env.mjs prisma db push",
    "db:seed": "node scripts/load-root-env.mjs node prisma/seed.mjs",
    "db:studio": "node scripts/load-root-env.mjs prisma studio",
    "qr": "node scripts/qr.mjs",
    "openapi:validate": "node -e \"require('@apidevtools/swagger-parser').validate('openapi/openapi.yaml').then(a=>console.log('valid:',a.info.title,a.info.version)).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "docker": "docker compose up -d",
    "docker:stop": "docker compose down",
    "docker:rebuild": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f",
    "docker:setup": "docker compose --profile setup run --rm migrate",
    "docker:seed": "docker compose --profile setup run --rm migrate npm run db:seed",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build --renew-anon-volumes",
    "docker:dev:stop": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "bcryptjs": "2.4.3",
    "cloudinary": "^2.11.0",
    "jose": "5.9.6",
    "next": "^15.5.25",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^24.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.5.6",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "jsdom": "^29.1.1",
    "openapi-types": "^12.1.3",
    "postcss": "^8.5.28",
    "prisma": "6.2.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "^3.2.7"
  }
}
